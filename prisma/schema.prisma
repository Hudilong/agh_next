generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}


enum NewsBlockType {
  PARAGRAPH
  HEADING
  QUOTE
  LIST
  TABLE
  CODE
  IMAGE
  HTML
}


model NewsSection {
  id         Int           @id @default(autoincrement())
  title      String        @db.VarChar(200)
  slug       String        @unique @db.VarChar(150)
  sortOrder  Float?
  createdAt  DateTime      @default(now()) @db.DateTime(0)
  updatedAt  DateTime      @updatedAt @db.DateTime(0)

  articles   NewsArticle[]

  @@map("news_sections")
}


model NewsArticle {
  id           Int           @id @default(autoincrement())
  sectionId    Int
  slug         String        @unique @db.VarChar(200)
  title        String        @db.VarChar(255)
  subtitle     String?       @db.VarChar(255)
  excerpt      String?       @db.Text
  author       String?       @db.VarChar(150)
  status       ArticleStatus @default(DRAFT)
  publishedAt  DateTime?     @db.DateTime(0)
  isFeatured   Boolean       @default(false)
  legacyId     Int?
  createdAt    DateTime      @default(now()) @db.DateTime(0)
  updatedAt    DateTime      @updatedAt @db.DateTime(0)

  section      NewsSection   @relation(fields: [sectionId], references: [id])
  blocks       NewsBlock[]

  @@index([sectionId])
  @@map("news_articles")
}


model NewsBlock {
  id        Int            @id @default(autoincrement())
  articleId Int
  position  Int            @default(0)
  type      NewsBlockType
  content   String?        @db.Text
  meta      Json?
  createdAt DateTime       @default(now()) @db.DateTime(0)

  article   NewsArticle    @relation(fields: [articleId], references: [id])

  @@index([articleId, position])
  @@map("news_blocks")
}


model actes {
  communeevenement Int?
  saisi            Int?
  numeroacte       Int?
  dateacte         DateTime? @db.DateTime(0)
  pageacte         Int?
  typeacte         String?   @db.VarChar(1)
